# Copy to .env, chmod 0600, then supply private values. Do not commit .env.
PGPASSWORD=
SECRET_KEY_BASE=
# SMTP is the default. For webhooks/Teams see docs/WEBHOOK-NOTIFICATIONS.md.
# MONDEK_NOTIFICATION_ADAPTER=webhook
# MONDEK_WEBHOOK_CONFIG_FILE=/run/secrets/mondek-webhooks.json
# Mount the private JSON file read-only into the controller.
# Explicitly choose your SMTP relay and recipient; localhost means the container.
MONDEK_SMTP_HOST=
MONDEK_SMTP_PORT=587
MONDEK_SMTP_TRANSPORT=starttls
MONDEK_SMTP_FROM=
MONDEK_SMTP_TO=
# If your relay requires authentication, set both privately:
# MONDEK_SMTP_USERNAME=
# MONDEK_SMTP_PASSWORD=
MONDEK_PORT=4000
# For HTTPS behind an authenticating reverse proxy, additionally set:
# MONDEK_DEPLOYMENT_MODE=true
# MONDEK_PUBLIC_URL=https://monitoring.example.test
