!tests/performance/consumer.py
!tests/performance/supervisor.py
!tests/performance/sample.py

!licensing/
licensing/*
!licensing/runtime-sources.json
!licensing/runtime/
!licensing/runtime/**

# These remain excluded even inside an allowed source tree.
**/.git
**/.local
**/.devenv*
**/node_modules
**/_build
**/deps
**/.venv
**/__pycache__
**/.ruff_cache
**/.pytest_cache
**/.env
**/.env.*
**/*.pem
**/*.key
controller/priv/static/assets
