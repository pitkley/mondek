*
# Build inputs are opt-in. Compose files, docs and local state stay on the host.
!LICENSE
!THIRD_PARTY_LICENSES.md

!controller/
controller/*
!controller/mix.exs
!controller/mix.lock
!controller/docker-entrypoint.sh
!controller/config/
!controller/config/**
!controller/lib/
!controller/lib/**
!controller/priv/
!controller/priv/**
!controller/assets/
controller/assets/*
!controller/assets/package.json
!controller/assets/package-lock.json
!controller/assets/icons.mjs
!controller/assets/css/
!controller/assets/css/**
!controller/assets/js/
!controller/assets/js/**

!runner/
runner/*
!runner/pyproject.toml
!runner/uv.lock
!runner/README.md
!runner/LICENSE
!runner/THIRD_PARTY_LICENSES.md
!runner/mondek_runner/
!runner/mondek_runner/**

!examples/
examples/*
!examples/demo_checks/
!examples/demo_checks/**
!examples/consumers/
!examples/consumers/**
!examples/policy/
!examples/policy/**

!tests/
tests/*
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/service.py
!tests/fixtures/node.py
!tests/browser/
tests/browser/*
!tests/browser/package.json
!tests/browser/package-lock.json
!tests/browser/*.mjs
!tests/browser/specs/
!tests/browser/specs/**
!tests/browser/support/
!tests/browser/support/**
!tests/browser/fleet/
!tests/browser/fleet/**
!tests/performance/
